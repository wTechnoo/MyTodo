<Window x:Class="MyTodo.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MyTodo.WPF"
        mc:Ignorable="d"
        Title="Todos" Height="450" Width="800">
    <Grid Background="Red">
        <ListView Background="Magenta" ItemsSource="{Binding TodosViewModel}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Done" DisplayMemberBinding="{Binding Done}" Width="50"/>
                    <GridViewColumn Header="Id" DisplayMemberBinding="{Binding Id}" Width="50"/>
                    <GridViewColumn Header="Title" DisplayMemberBinding="{Binding Title}" Width="200"/>
                    <GridViewColumn Header="Description" DisplayMemberBinding="{Binding Description}" Width="400"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>
